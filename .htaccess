# 梯子指南针 Apache / LiteSpeed Web Server 配置
<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

    # 1. 静态物理资源存在时直接响应，绝不重定向或重写回 index.html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 1.1 Clean URL 支持 (如 /network-routing-decision-compass-2026 -> /network-routing-decision-compass-2026.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ $1.html [L]

  # 2. 静态扩展名保护：禁止任何静态文件命中回退
  RewriteCond %{REQUEST_URI} \.(css|js|svg|png|jpg|jpeg|gif|webp|ico|json|txt|xml|woff|woff2)$ [NC]
  RewriteRule ^ - [L]
</IfModule>

# 静态资源缓存控制
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Content-Type "text/css; charset=utf-8" "expr=%{REQUEST_URI} =~ /\.css$/"
    Header set Content-Type "text/javascript; charset=utf-8" "expr=%{REQUEST_URI} =~ /\.js$/"
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
