# 梯子指南针 Apache / LiteSpeed Web Server 配置
<IfModule mod_mime.c>
  AddType text/css .css
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/x-icon .ico
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. AFF 推广外链 301 状态码永久重定向
  RewriteRule ^go/huanqiuti$ https://123pps01.huanqiutiaff.com/#/?code=j5VBUvw0 [R=301,L]
  RewriteRule ^go/dalaoyun$ https://ppsvip01.dalaoyunaff.com/#/?code=Iz1GlCVa [R=301,L]
  RewriteRule ^go/yunjiexian$ https://pp01.yunjiexianaff.com/#/?code=bp0ZSKBV [R=301,L]
  RewriteRule ^go/shandianshu$ https://ppsvip01.shandianshuaff.com/#/?code=QbLF8tjB [R=301,L]
  RewriteRule ^go/shenxing$ https://pps123.shenxingaff.com/#/?code=6tQ7zHUc [R=301,L]
  RewriteRule ^go/liulianyun$ https://123pp01.liulianyunaff.com/#/?code=MsZP3u7G [R=301,L]
  RewriteRule ^go/kuaili$ https://iasfa.kuailitztz2.sbs/#/?code=e0cAmK7F [R=301,L]
  RewriteRule ^go/guangnianti$ https://bk1dvc.guangnianertt1.homes/#/?code=PQhPFDhO [R=301,L]
  RewriteRule ^go/edgenode$ https://zvbghs02.ztymforedge.lol/#/?code=mLLL6h6F [R=301,L]
  RewriteRule ^go/shunyun$ https://ddd.jichang.best/#/register?code=nldUZaYc [R=301,L]
  RewriteRule ^go/kexinyun$ https://asfasf.kexintztz2.sbs/#/?code=sFKkfEYs [R=301,L]
  RewriteRule ^go/yuntu$ https://super.ytjcok.org/#/register?code=poKwFVtv [R=301,L]
  RewriteRule ^go/jilianyun$ https://poajufr.jilianat.homes/#/?code=jwCMOvQO [R=301,L]
  RewriteRule ^go/sujie$ https://momlise.szjtfp.xyz/#/?code=kcoensXG [R=301,L]
  RewriteRule ^go/kunpeng$ https://kunpengjiasu.com/#/register?code=WPugVZUe [R=301,L]
  RewriteRule ^go/telegram$ https://t.me/huanqiuti8899 [R=301,L]
  RewriteRule ^go/tg-kefu$ https://t.me/huanqiuti8899 [R=301,L]

    # 1. 静态物理资源存在时直接响应，绝不重定向或重写回 index.html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 1.1 Clean URL 支持 (如 /network-routing-decision-compass-2026 -> /network-routing-decision-compass-2026.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^.]+)$ $1.html [L]

  # 2. 静态扩展名保护：禁止任何静态文件命中回退
  RewriteCond %{REQUEST_URI} \.(css|js|svg|png|jpg|jpeg|gif|webp|ico|json|txt|xml|woff|woff2)$ [NC]
  RewriteRule ^ - [L]
</IfModule>

# 静态资源缓存控制
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Content-Type "text/css; charset=utf-8" "expr=%{REQUEST_URI} =~ /\.css$/"
    Header set Content-Type "text/javascript; charset=utf-8" "expr=%{REQUEST_URI} =~ /\.js$/"
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
